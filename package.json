{
  "name": "staylinked",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run rust:build && node --env-file-if-exists=.env server/index.mjs",
    "build": "npm run rust:build && tsc -b && vite build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run rust:test && npm run rust:check && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:build": "node scripts/rust.mjs build --release --locked",
    "rust:test": "node scripts/rust.mjs test --locked",
    "rust:check": "node scripts/rust.mjs fmt --check && node scripts/rust.mjs clippy --locked --all-targets -- -D warnings",
    "provider:check": "node --env-file-if-exists=.env scripts/provider-check.mjs",
    "avatars:generate": "node scripts/avatars.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "express": "^5.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.47.0",
    "multer": "^2.4.0",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
