# Add your key later. Never prefix secrets with VITE_.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# Choose a model supporting /chat/completions, not /messages or /responses.
OPENCODE_MODEL=glm-5.2
PORT=5173
# Set this to the laptop's LAN address for phone QR scans on the same Wi-Fi.
# Example: http://192.168.1.25:5173
PUBLIC_URL=
# Demo accounts and synthetic data are enabled for the local prototype.
DEMO_MODE=true
